# Copy this file to `.env.local` (local dev) and set the same variables in your
# hosting provider's dashboard (e.g. Vercel → Project → Settings → Environment Variables).

# --- Supabase (required) ---------------------------------------------------
# Project URL, e.g. https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# Service role key — SERVER ONLY. Never expose this to the browser or commit it.
# Found in Supabase → Project Settings → API → service_role.
SUPABASE_SERVICE_ROLE_KEY=

# --- OpenAI (required) -----------------------------------------------------
# API key used to generate coach replies.
OPENAI_API_KEY=
# Optional. Defaults to gpt-4o-mini when unset.
OPENAI_MODEL=gpt-4o-mini

# --- Tavily web search (optional) ------------------------------------------
# Enables the coaches' live web_search tool. Without it, coaches still work
# but cannot look up time-sensitive info (deadlines, rule changes, etc.).
TAVILY_API_KEY=
